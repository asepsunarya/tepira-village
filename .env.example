# ── Backend yang SAMA dengan repo tepira ────────────────────────────────────
# Pakai DATABASE_URL yang sama persis dengan deployment tepira (Supabase/Neon),
# supaya goal, setoran, pengeluaran, dan dompet yang tampil di desa adalah
# data yang sama dengan tepira.id.
DATABASE_URL="postgresql://..."

# ── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
# Boleh memakai AUTH_SECRET yang berbeda dari tepira (cookie per-domain).
AUTH_SECRET="generate-dengan-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Boleh memakai Google OAuth client yang sama dengan tepira. Tambahkan
# redirect URI berikut di Google Cloud Console → Credentials:
#   http://localhost:3000/api/auth/callback/google
#   https://<domain-tepira-village>/api/auth/callback/google
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ── Opsional ────────────────────────────────────────────────────────────────
# PIN untuk membuka angka sensitif (sama seperti APP_PIN di tepira). Kalau
# kosong, tombol "sembunyikan angka" hanya toggle lokal tanpa PIN.
APP_PIN=""

# HANYA UNTUK DEVELOPMENT LOKAL: login tanpa Google. Diabaikan saat
# NODE_ENV=production. Email harus ada / akan dibuat di tabel User.
DEV_LOGIN_EMAIL=""
