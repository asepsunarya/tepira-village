// ─────────────────────────────────────────────────────────────────────────────
// SKEMA INI DISALIN APA ADANYA DARI REPO BACKEND `tepira` (prisma/schema.prisma).
//
// tepira-village memakai DATABASE yang SAMA dengan tepira. Repo ini TIDAK
// memiliki migrasi sendiri: skema & migrasi tetap dimiliki oleh repo tepira.
// Kalau tepira mengubah skema, salin ulang file ini lalu `npm run prisma:generate`.
//
// Untuk development lokal tanpa Supabase, `npm run db:push:dev` membuat tabel
// yang sama di Postgres lokal (hanya untuk dev, jangan dipakai ke DB produksi).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
  expenses      Expense[]
  salaries      Salary[]
  bonuses       Bonus[]
  balances      Balance[]
  wallets       Wallet[]
  weeklyFinancialInsights WeeklyFinancialInsight[]
  recurringTransactions RecurringTransaction[]
  recurringOccurrences  RecurringOccurrence[]
  webPushSubscriptions  WebPushSubscription[]
  reminderPreference    ReminderPreference?
  noSpendDays           NoSpendDay[]
  placeSpendLimits      PlaceSpendLimit[]
  villageStates         VillageState[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Goal {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  targetAmount  Int
  deadline      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions Contribution[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

model Contribution {
  id     Int      @id @default(autoincrement())
  amount Int
  note   String?
  date   DateTime @default(now())
  goal   Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId Int
  recurringOccurrence RecurringOccurrence?
}

model Expense {
  id        Int      @id @default(autoincrement())
  amount    Int
  category  String?
  note      String?
  source    String?  @default("gaji") // "gaji" or "bonus"
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId  Int?
  wallet    Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  // Lokasi opsional untuk "peta jajan" di tepira-village; null = tanpa lokasi.
  placeName String?
  latitude  Float?
  longitude Float?
  recurringOccurrence RecurringOccurrence?

  @@index([userId])
  @@index([walletId])
}

model Salary {
  id                     Int                @id @default(autoincrement())
  amount                 Int
  month                  Int
  year                   Int
  totalExpenseAllocation Int
  savingsAllocation      Int
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  allocations            BudgetAllocation[]
  userId                 String?
  user                   User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
}

model BudgetAllocation {
  id        Int      @id @default(autoincrement())
  category  String
  amount    Int
  salary    Salary   @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  salaryId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bonus {
  id          Int               @id @default(autoincrement())
  amount      Int
  month       Int
  year        Int
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  allocations BonusAllocation[]
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
}

model BonusAllocation {
  id        Int      @id @default(autoincrement())
  category  String
  amount    Int
  bonus     Bonus    @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  bonusId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Balance {
  id        Int      @id @default(autoincrement())
  amount    Int
  month     Int
  year      Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
}


model Wallet {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   @default("bank") // bank, e-wallet, cash, investment, credit, paylater, other
  balance     Int
  description String?
  isDebt      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@index([userId, sortOrder])
}


model WeeklyFinancialInsight {
  id              Int      @id @default(autoincrement())
  weekStart       DateTime
  weekEnd         DateTime
  month           Int
  year            Int
  healthScore     Int
  status          String
  summary         String   @db.Text
  recommendations Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, year, month])
}

// ── tepira-village: transaksi berulang ("tukang pos") ───────────────────────
// Aturan berulang: langganan, cicilan, sewa (kind "expense") atau setoran rutin ke goal (kind "saving").
model RecurringTransaction {
  id              Int                   @id @default(autoincrement())
  kind            String                @default("expense") // "expense" | "saving"
  title           String // "Spotify", "Cicilan HP", "Kos"
  amount          Int
  category        String? // label kategori tepira (kind "expense")
  note            String?
  source          String                @default("gaji") // "gaji" | "bonus" (kind "expense")
  frequency       String                @default("monthly") // "weekly" | "monthly" | "yearly"
  repeatEvery     Int                   @default(1) // tiap N minggu/bulan/tahun
  dayOfMonth      Int? // 1..31 (monthly/yearly); 29-31 dijepit ke hari terakhir bulan itu
  startDate       DateTime              @db.Date // jatuh tempo pertama (hari WIB)
  nextDueDate     DateTime              @db.Date // jatuh tempo berikutnya yang BELUM dibuatkan occurrence
  maxOccurrences  Int? // cicilan 12x; null = tanpa akhir
  occurrenceCount Int                   @default(0)
  mode            String                @default("confirm") // "confirm" | "auto"
  active          Boolean               @default(true)
  placeName       String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        Int?
  wallet          Wallet?               @relation(fields: [walletId], references: [id], onDelete: SetNull)
  goalId          Int?
  goal            Goal?                 @relation(fields: [goalId], references: [id], onDelete: Cascade)
  occurrences     RecurringOccurrence[]

  @@index([userId])
  @@index([active, nextDueDate])
  @@index([walletId])
  @@index([goalId])
}

// Satu jatuh tempo = satu "surat tagihan" di kotak pos. (recurringId, dueDate) unik = kunci idempoten.
model RecurringOccurrence {
  id             Int                  @id @default(autoincrement())
  dueDate        DateTime             @db.Date
  amount         Int
  status         String               @default("pending") // "pending" | "posted" | "skipped"
  postedVia      String? // "auto" | "confirm"
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  recurringId    Int
  recurring      RecurringTransaction @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseId      Int?                 @unique
  expense        Expense?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  contributionId Int?                 @unique
  contribution   Contribution?        @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  @@unique([recurringId, dueDate])
  @@index([userId, status])
}

// ── tepira-village: web push ─────────────────────────────────────────────────
// Satu baris per browser/perangkat. Bukan "PushSubscription" supaya tipe Prisma tidak bentrok dengan tipe DOM.
model WebPushSubscription {
  id             Int       @id @default(autoincrement())
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  userAgent      String?
  failureCount   Int       @default(0)
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReminderPreference {
  userId       String    @id
  lampReminder Boolean   @default(true)
  billReminder Boolean   @default(true)
  lampSentOn   DateTime? @db.Date
  billSentOn   DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── tepira-village: state per user yang dulu di localStorage ─────────────────
model NoSpendDay {
  userId    String
  day       DateTime @db.Date // hari WIB; = wibDayDate(day) di desa
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model PlaceSpendLimit {
  userId       String
  placeKey     String // normalizePlaceName(placeName)
  placeName    String
  monthlyLimit Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, placeKey])
}

model VillageState {
  userId    String
  key       String // "letter" | "seen" | "tour" | ...
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}
